          "raw": "{\n  \"title\": \"Royal Enfield Classic 350\",\n  \"description\": \"Single owner, good condition, all documents clear.\",\n  \"price\": 175000,\n  \"itemCondition\": \"GOOD\",\n  \"categoryId\": 2,\n  \"sellerId\": 1,\n  \"city\": \"Bengaluru\",\n  \"imageUrl\": \"https://placehold.co/600x400?text=Bike\"\n}"
